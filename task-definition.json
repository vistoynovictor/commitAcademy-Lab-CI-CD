{
  "family": "ci-cd-lab-task",
  "networkMode": "bridge",
  "cpu": "512",
  "memory": "1024",
  "requiresCompatibilities": [
    "EC2"
  ],
  "containerDefinitions": [
    {
      "name": "gh-container",
      "image": "<ECR_IMAGE_URI>",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ]
}
